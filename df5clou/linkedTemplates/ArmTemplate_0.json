						"userProperties": [],
						"typeProperties": {
							"message": {
								"value": "@string(activity('silver to gold').output.error.code)",
								"type": "Expression"
							},
							"errorCode": {
								"value": "@string(activity('silver to gold').output.error.message)",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"windowStart": {
						"type": "String"
					}
				},
				"variables": {
					"pip-timestamp": {
						"type": "String"
					},
					"pip-hour": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2025-11-07T08:49:42Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/SourceDataset_cnw')]",
