							},
							"errorCode": {
								"value": "@string(activity('Copy_cnw').output.error.code)",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Fail bronze to silver",
						"type": "Fail",
						"dependsOn": [
							{
								"activity": "Bronze to silver",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"message": {
								"value": "@string(activity('Bronze to silver').output.error.code)",
								"type": "Expression"
							},
							"errorCode": {
								"value": "@string(activity('Bronze to silver').output.error.message)",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Fail silver to gold",
						"type": "Fail",
						"dependsOn": [
							{
								"activity": "silver to gold",
								"dependencyConditions": [
									"Failed"
								]
