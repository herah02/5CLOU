				"metadata": {
					"saveOutput": true,
					"enableDebugMode": false,
					"kernelspec": {
						"name": "synapse_pyspark",
						"display_name": "Synapse PySpark"
					},
					"language_info": {
						"name": "python"
					},
					"a365ComputeOptions": {
						"id": "/subscriptions/9230ca48-750c-4d03-a5c6-a58d6d6db49c/resourceGroups/5CLOU/providers/Microsoft.Synapse/workspaces/syws5clou/bigDataPools/sp5clou",
						"name": "sp5clou",
						"type": "Spark",
						"endpoint": "https://syws5clou.dev.azuresynapse.net/livyApi/versions/2019-11-01-preview/sparkPools/sp5clou",
						"auth": {
							"type": "AAD",
							"authResource": "https://dev.azuresynapse.net"
						},
						"sparkVersion": "3.5",
						"nodeCount": 3,
						"cores": 4,
						"memory": 28
					},
					"sessionKeepAliveTimeout": 2
				},
				"cells": [
					{
						"cell_type": "code",
						"source": [
							"from pyspark.sql import SparkSession\n",
							"from pyspark.sql.functions import col, lower, trim, regexp_replace, to_timestamp, year, month, dayofmonth, hour\n",
							"\n",
							" \n",
							"spark = SparkSession.builder.appName(\"BronzeToSilver\").getOrCreate()\n",
							" \n",
							"df_raw = spark.read.option(\"recursiveFileLookup\", \"true\").parquet(f\"abfss://dlfs5clou-raw@dl5clou.dfs.core.windows.net/\")\n",
							" \n",
							"df_clean = (\n",
							"    df_raw\n",
							"    .dropDuplicates()\n",
							"    .withColumn(\"content\", trim(col(\"content\")))\n",
							"    .withColumn(\"content\", regexp_replace(col(\"content\"), r'\\s+', ' '))\n",
							"    .withColumn(\"content_lower\", lower(col(\"content\")))\n",
							"    .withColumn(\"timestamp\", to_timestamp(col(\"created_at\")))\n",
							")\n",
							" \n",
							"df_clean = (\n",
							"    df_clean\n",
							"    .withColumn(\"year\", year(col(\"timestamp\")))\n",
							"    .withColumn(\"month\", month(col(\"timestamp\")))\n",
							"    .withColumn(\"day\", dayofmonth(col(\"timestamp\")))\n",
							"    .withColumn(\"hour\", hour(col(\"timestamp\")))\n",
							")\n",
							" \n",
							"\n",
							"(\n",
							"    df_clean\n",
							"    .write\n",
							"    .mode(\"overwrite\")\n",
							"    .parquet(\"abfss://dlfs5clou-clean@dl5clou.dfs.core.windows.net/clean/\")\n",
							")"
						],
						"outputs": [],
						"execution_count": 4
					}
				]
			},
			"dependsOn": []
		},
