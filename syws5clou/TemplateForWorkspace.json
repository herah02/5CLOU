						"name": "python"
					},
					"a365ComputeOptions": {
						"id": "/subscriptions/9230ca48-750c-4d03-a5c6-a58d6d6db49c/resourceGroups/5CLOU/providers/Microsoft.Synapse/workspaces/syws5clou/bigDataPools/sp5clou",
						"name": "sp5clou",
						"type": "Spark",
						"endpoint": "https://syws5clou.dev.azuresynapse.net/livyApi/versions/2019-11-01-preview/sparkPools/sp5clou",
						"auth": {
							"type": "AAD",
							"authResource": "https://dev.azuresynapse.net"
						},
						"sparkVersion": "3.5",
						"nodeCount": 3,
						"cores": 4,
						"memory": 28
					},
					"sessionKeepAliveTimeout": 1
				},
				"cells": [
					{
						"cell_type": "code",
						"source": [
							"from pyspark.sql import functions as F\n",
							"\n",
							"df = spark.read.option(\"recursiveFileLookup\", \"true\").parquet(f\"abfss://dlfs5clou-clean@dl5clou.dfs.core.windows.net/clean/\")\n",
							"print(df)\n",
							"df_active_users = (\n",
							"    df.groupBy(\"account_id\")\n",
							"      .agg(F.count(\"*\").alias(\"toots_count\"))\n",
							"      .orderBy(F.desc(\"toots_count\"))\n",
							")\n",
							"\n",
							"df_active_users.write \\\n",
							"    .format(\"delta\") \\\n",
							"    .mode(\"overwrite\") \\\n",
							"    .saveAsTable(\"Database1.active_users\")"
						],
						"outputs": [],
						"execution_count": 28
					},
					{
						"cell_type": "code",
						"source": [
							"\n",
							"df_total_toots = (\n",
							"    df.groupBy(\"year\", \"month\", \"day\")\n",
							"      .agg(F.count(\"*\").alias(\"total_toots\"))\n",
							"      .orderBy(\"year\", \"month\", \"day\")\n",
							")\n",
							"df_total_toots.write \\\n",
							"    .format(\"delta\") \\\n",
							"    .mode(\"overwrite\") \\\n",
							"    .saveAsTable(\"Database1.total_toots_per_day\")"
						],
						"outputs": [],
						"execution_count": 29
					},
					{
						"cell_type": "code",
						"source": [
							"from pyspark.sql.functions import explode, regexp_extract, split, col\n",
							"# Extraire les hashtags\n",
							"df_hashtags = (\n",
							"    df.withColumn(\"hashtags\", split(regexp_extract(col(\"content_lower\"), r'#\\w+', 0), ' '))\n",
							"    .withColumn(\"hashtag\", explode(col(\"hashtags\")))\n",
							"    .groupBy(\"hashtag\")\n",
							"    .agg(F.count(\"*\").alias(\"count\"))\n",
							"    .orderBy(F.desc(\"count\"))\n",
							")\n",
							"\n",
							"\n",
							"df_hashtags.write \\\n",
							"    .format(\"delta\") \\\n",
							"    .mode(\"overwrite\") \\\n",
							"    .saveAsTable(\"Database1.trending_hashtags\")\n",
							""
						],
						"outputs": [],
						"execution_count": 30
					}
				]
			},
