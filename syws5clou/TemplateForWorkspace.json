						"spark.autotune.trackingId": "7f05fa1b-7f9e-490e-b4d0-51369e849ba4"
					}
				},
				"metadata": {
					"saveOutput": true,
					"enableDebugMode": false,
					"kernelspec": {
						"name": "synapse_pyspark",
						"display_name": "Synapse PySpark"
					},
					"language_info": {
						"name": "python"
					},
					"a365ComputeOptions": {
						"id": "/subscriptions/9230ca48-750c-4d03-a5c6-a58d6d6db49c/resourceGroups/5CLOU/providers/Microsoft.Synapse/workspaces/syws5clou/bigDataPools/sp5clou",
						"name": "sp5clou",
						"type": "Spark",
						"endpoint": "https://syws5clou.dev.azuresynapse.net/livyApi/versions/2019-11-01-preview/sparkPools/sp5clou",
						"auth": {
							"type": "AAD",
							"authResource": "https://dev.azuresynapse.net"
						},
						"sparkVersion": "3.5",
						"nodeCount": 3,
						"cores": 4,
						"memory": 28
					},
					"sessionKeepAliveTimeout": 2
				},
				"cells": [
					{
						"cell_type": "code",
						"source": [
							"from pyspark.sql import SparkSession\n",
							"from pyspark.sql.functions import (\n",
							"    col, lower, trim, regexp_replace, to_timestamp, to_date,\n",
							"    year, month, dayofmonth, hour, length\n",
							")\n",
							"from pyspark.sql.types import StringType\n",
							" \n",
							"spark = SparkSession.builder.appName(\"BronzeToSilver\").getOrCreate()\n",
							" \n",
							"df_raw = (\n",
							"    spark.read\n",
							"    .option(\"recursiveFileLookup\", \"true\")\n",
							"    .parquet(\"abfss://dlfs5clou-raw@dl5clou.dfs.core.windows.net/\")\n",
							")\n",
							" \n",
							"# -----------------------------\n",
							"# 1. Standardisation du schéma\n",
							"# -----------------------------\n",
							"df = (\n",
							"    df_raw\n",
							"    .withColumn(\"id\", col(\"id\").cast(\"string\"))\n",
							"    .withColumn(\"account_id\", col(\"account_id\").cast(\"string\"))\n",
							"    .withColumn(\"content\", col(\"content\").cast(StringType()))\n",
							"    .withColumn(\"created_at\", to_timestamp(\"created_at\"))\n",
							")\n",
							" \n",
							"# -----------------------------\n",
							"# 2. Nettoyage & Qualité\n",
							"# -----------------------------\n",
							"df = (\n",
							"    df\n",
							"    .dropDuplicates([\"id\"])                                      \n",
							"    .filter(col(\"content\").isNotNull() & (length(col(\"content\")) > 0))\n",
							")\n",
							" \n",
							"# -----------------------------\n",
							"# 3. Nettoyage avancé du texte\n",
							"# -----------------------------\n",
							"df = (\n",
							"    df\n",
							"    .withColumn(\"content\", trim(col(\"content\")))\n",
							"    .withColumn(\"content\", regexp_replace(\"content\", r\"<[^>]+>\", \"\"))  # supprime HTML\n",
							"    .withColumn(\"content\", regexp_replace(\"content\", r\"[^\\x00-\\x7F]+\", \"\"))  # supprime emojis\n",
							"    .withColumn(\"content\", regexp_replace(\"content\", r'[\\s]+', \" \"))   # espace unique\n",
							"    .withColumn(\"content_clean\", lower(col(\"content\")))\n",
							"    .withColumn(\"content_length\", length(col(\"content_clean\")))\n",
							")\n",
							" \n",
							"# -----------------------------\n",
							"# 4. Enrichissement\n",
							"# -----------------------------\n",
							"df = (\n",
							"    df\n",
							"    .withColumn(\"event_date\", to_date(col(\"created_at\")))\n",
							"    .withColumn(\"year\", year(col(\"created_at\")))\n",
							"    .withColumn(\"month\", month(col(\"created_at\")))\n",
							"    .withColumn(\"day\", dayofmonth(col(\"created_at\")))\n",
							"    .withColumn(\"hour\", hour(col(\"created_at\")))\n",
							")\n",
							" \n",
							"# -----------------------------\n",
							"# 5. Écriture Silver\n",
							"# -----------------------------\n",
							"(\n",
							"    df.write\n",
							"    .mode(\"overwrite\")\n",
							"    .parquet(\"abfss://dlfs5clou-clean@dl5clou.dfs.core.windows.net/clean/\")\n",
							")"
						],
						"outputs": [],
						"execution_count": null
					}
				]
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/silver-to-gold')]",
			"type": "Microsoft.Synapse/workspaces/notebooks",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"nbformat": 4,
				"nbformat_minor": 2,
				"bigDataPool": {
					"referenceName": "sp5clou",
					"type": "BigDataPoolReference"
				},
				"sessionProperties": {
					"driverMemory": "28g",
					"driverCores": 4,
					"executorMemory": "28g",
					"executorCores": 4,
					"numExecutors": 1,
					"runAsWorkspaceSystemIdentity": false,
					"conf": {
						"spark.dynamicAllocation.enabled": "false",
						"spark.dynamicAllocation.minExecutors": "1",
						"spark.dynamicAllocation.maxExecutors": "1",
						"spark.autotune.trackingId": "f28eef54-e992-4a19-8604-809e8daf8526"
					}
				},
				"metadata": {
					"saveOutput": true,
					"enableDebugMode": false,
					"kernelspec": {
						"name": "synapse_pyspark",
						"display_name": "Synapse PySpark"
					},
					"language_info": {
						"name": "python"
					},
					"a365ComputeOptions": {
						"id": "/subscriptions/9230ca48-750c-4d03-a5c6-a58d6d6db49c/resourceGroups/5CLOU/providers/Microsoft.Synapse/workspaces/syws5clou/bigDataPools/sp5clou",
						"name": "sp5clou",
						"type": "Spark",
						"endpoint": "https://syws5clou.dev.azuresynapse.net/livyApi/versions/2019-11-01-preview/sparkPools/sp5clou",
						"auth": {
							"type": "AAD",
							"authResource": "https://dev.azuresynapse.net"
						},
						"sparkVersion": "3.5",
						"nodeCount": 3,
						"cores": 4,
						"memory": 28,
						"automaticScaleJobs": false
					},
					"sessionKeepAliveTimeout": 1
				},
				"cells": [
					{
						"cell_type": "code",
						"metadata": {},
						"source": [
							"from pyspark.sql import SparkSession\n",
							"from pyspark.sql import functions as F\n",
							"from pyspark.sql.functions import explode\n",
							"from pyspark.sql.types import DateType\n",
							" \n",
							"spark = SparkSession.builder.getOrCreate()\n",
							" \n",
							"# Chargement du parquet\n",
							"df = (\n",
							"    spark.read\n",
							"        .option(\"recursiveFileLookup\", \"true\")\n",
							"        .parquet(\"abfss://dlfs5clou-clean@dl5clou.dfs.core.windows.net/clean/\")\n",
							")\n",
							" \n",
							"# Ajout des colonnes temps\n",
							"df = (\n",
							"    df.withColumn(\"year\", F.year(\"event_date\"))\n",
							"      .withColumn(\"month\", F.month(\"event_date\"))\n",
							"      .withColumn(\"day\", F.dayofmonth(\"event_date\"))\n",
							"      .withColumn(\"hour\", F.hour(\"created_at\"))\n",
							")\n",
							" \n",
							"# ================================\n",
							"# TABLE : USER STATS\n",
							"# ================================\n",
							"df_user_stats = (\n",
							"    df.groupBy(\"account_id\")\n",
							"      .agg(\n",
							"          F.count(\"*\").alias(\"toots_count\"),\n",
							"          F.avg(\"content_length\").alias(\"avg_length\"),\n",
							"          (F.sum(F.size(F.split(\"content_lower\", \"#\")) - 1)).alias(\"hashtag_count\"),\n",
							"          F.countDistinct(\"event_date\").alias(\"active_days\"),\n",
							"          F.min(\"created_at\").alias(\"first_toot\"),\n",
							"          F.max(\"created_at\").alias(\"last_toot\"),\n",
							"          F.expr(\"percentile_approx(hour, 0.5)\").alias(\"median_active_hour\")\n",
							"      )\n",
							"      .orderBy(F.desc(\"toots_count\"))\n",
							")\n",
							" \n",
							"df_user_stats.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"Database1.user_stats\")\n",
							" \n",
							" \n",
							"# ================================\n",
							"# TOOTS PAR HEURE\n",
							"# ================================\n",
							"df_toots_by_hour = (\n",
							"    df.groupBy(\"year\", \"month\", \"day\", \"hour\")\n",
							"      .agg(F.count(\"*\").alias(\"total_toots\"))\n",
							")\n",
							"df_toots_by_hour.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"Database1.toots_by_hour\")\n",
							" \n",
							" \n",
							"# ================================\n",
							"# TOOTS PAR JOUR DE LA SEMAINE\n",
							"# ================================\n",
							"df_toots_weekday = (\n",
							"    df.withColumn(\"weekday\", F.date_format(\"event_date\", \"E\"))\n",
							"      .groupBy(\"weekday\")\n",
							"      .agg(F.count(\"*\").alias(\"total_toots\"))\n",
							")\n",
							"df_toots_weekday.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"Database1.toots_by_weekday\")\n",
							" \n",
							" \n",
							"# ================================\n",
							"# TABLE HASHTAGS TRENDING\n",
							"# ================================\n",
							"df_hashtags = (\n",
							"    df.withColumn(\"hashtags_raw\",\n",
							"                  F.regexp_replace(F.col(\"content_lower\"), \"[^#A-Za-z0-9_]\", \" \"))\n",
							"      .withColumn(\"hashtags\", F.split(\"hashtags_raw\", \" \"))\n",
							"      .withColumn(\"hashtag\", F.explode(\"hashtags\"))\n",
							"      .filter(F.col(\"hashtag\").like(\"#%\"))\n",
							"      .groupBy(\"hashtag\")\n",
							"      .agg(F.count(\"*\").alias(\"count\"))\n",
							"      .orderBy(F.desc(\"count\"))\n",
							")\n",
							" \n",
							"df_hashtags.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"Database1.trending_hashtags\")\n",
							" \n",
							" \n",
							"# ================================\n",
							"# TABLE WORD FREQUENCY\n",
							"# ================================\n",
							"df_words = (\n",
							"    df.withColumn(\"words\", F.split(\"content_clean\", \" \"))\n",
							"      .withColumn(\"word\", F.explode(\"words\"))\n",
							"      .filter(F.length(\"word\") > 3)\n",
							"      .groupBy(\"word\")\n",
							"      .agg(F.count(\"*\").alias(\"count\"))\n",
							")\n",
							" \n",
							"df_words.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"Database1.word_frequency\")\n",
							" \n",
							" \n",
							"# ================================\n",
							"# USER ACTIVITY CALENDAR\n",
							"# ================================\n",
							"df_user_calendar = (\n",
							"    df.groupBy(\"account_id\", \"event_date\")\n",
							"      .agg(F.count(\"*\").alias(\"toots\"))\n",
							")\n",
							" \n",
							"df_user_calendar.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"Database1.user_calendar\")\n",
							" \n",
							" \n",
							"# ================================\n",
							"# GENERATION DE LA TABLE CALENDRIER\n",
							"# ================================\n",
							"start = df.agg(F.min(\"event_date\")).first()[0]\n",
							"end = df.agg(F.max(\"event_date\")).first()[0]\n",
							" \n",
							"df_calendar = (\n",
							"    spark.range(0, (end - start).days + 1)\n",
							"        .withColumn(\"date\", (F.lit(start) + F.col(\"id\").cast(\"int\")).cast(DateType()))\n",
							"        .drop(\"id\")\n",
							"        .withColumn(\"year\", F.year(\"date\"))\n",
							"        .withColumn(\"month\", F.month(\"date\"))\n",
							"        .withColumn(\"day\", F.dayofmonth(\"date\"))\n",
							"        .withColumn(\"weekday_number\", F.dayofweek(\"date\"))\n",
							"        .withColumn(\"weekday_name\", F.date_format(\"date\", \"EEEE\"))\n",
							"        .withColumn(\"week_of_year\", F.weekofyear(\"date\"))\n",
							")\n",
							" \n",
							"df_calendar.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"Database1.dim_calendar\")\n",
							" \n",
							" \n",
							"# ================================\n",
							"# TABLE TOOTS DAILY\n",
							"# ================================\n",
							"df_toots_daily = (\n",
							"    df.groupBy(\"event_date\", \"year\", \"month\", \"day\")\n",
							"      .agg(\n",
							"          F.count(\"*\").alias(\"total_toots\"),\n",
							"          F.countDistinct(\"account_id\").alias(\"active_users\"),\n",
							"          F.avg(\"content_length\").alias(\"avg_length\")\n",
							"      )\n",
							")\n",
							" \n",
							"df_toots_daily.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"Database1.toots_daily\")"
						],
						"outputs": [],
						"execution_count": 28
					}
				]
			},
			"dependsOn": []
		},
