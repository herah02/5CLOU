{
	"name": "Pipeline 1",
	"properties": {
		"activities": [
			{
				"name": "Bronze to silver",
				"type": "SynapseNotebook",
				"dependsOn": [
					{
						"activity": "Import API Data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "bronze-to-silver",
						"type": "NotebookReference"
					},
					"snapshot": true,
					"sparkPool": {
						"referenceName": "sp5clou",
						"type": "BigDataPoolReference"
					},
					"executorSize": "Medium",
					"conf": {
						"spark.dynamicAllocation.enabled": true,
						"spark.dynamicAllocation.minExecutors": 1,
						"spark.dynamicAllocation.maxExecutors": 2
					},
					"driverSize": "Medium",
					"numExecutors": 1,
					"authentication": {
						"type": "MSI"
					}
				}
			},
			{
				"name": "siver to gold",
				"type": "SynapseNotebook",
				"dependsOn": [
					{
						"activity": "Bronze to silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "silver-to-gold",
						"type": "NotebookReference"
					},
					"snapshot": true,
					"sparkPool": {
						"referenceName": "sp5clou",
						"type": "BigDataPoolReference"
					},
					"executorSize": "Small",
					"conf": {
						"spark.dynamicAllocation.enabled": false,
						"spark.dynamicAllocation.minExecutors": 1,
						"spark.dynamicAllocation.maxExecutors": 1
					},
					"driverSize": "Small",
					"numExecutors": 1,
					"authentication": {
						"type": "MSI"
					}
				}
			},
			{
				"name": "Import API Data",
				"type": "Copy",
				"state": "Active",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Set variable2",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set variable1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"validateDataConsistency": true,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['id']"
								},
								"sink": {
									"name": "id",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['created_at']"
								},
								"sink": {
									"name": "created_at",
									"type": "DateTime"
								}
							},
							{
								"source": {
									"path": "$['visibility']"
								},
								"sink": {
									"name": "visibility",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['language']"
								},
								"sink": {
									"name": "language",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['replies_count']"
								},
								"sink": {
									"name": "replies_count",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "$['reblogs_count']"
								},
								"sink": {
									"name": "reblogs_count",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "$['favourites_count']"
								},
								"sink": {
									"name": "favourites_count",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "$['quotes_count']"
								},
								"sink": {
									"name": "quotes_count",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "$['content']"
								},
								"sink": {
									"name": "content",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['account']['id']"
								},
								"sink": {
									"name": "account_id",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['account']['username']"
								},
								"sink": {
									"name": "username",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['account']['display_name']"
								},
								"sink": {
									"name": "display_name",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['account']['bot']"
								},
								"sink": {
									"name": "bot",
									"type": "Boolean"
								}
							},
							{
								"source": {
									"path": "$['account']['group']"
								},
								"sink": {
									"name": "group",
									"type": "Boolean"
								}
							},
							{
								"source": {
									"path": "$['account']['created_at']"
								},
								"sink": {
									"name": "account_created_at",
									"type": "DateTime"
								}
							}
						],
						"collectionReference": ""
					}
				},
				"inputs": [
					{
						"referenceName": "apiMastodon",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DestRaw",
						"type": "DatasetReference",
						"parameters": {
							"fileName": {
								"value": "@variables('file')",
								"type": "Expression"
							},
							"folderPath": {
								"value": "@variables('timestamp')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "timestamp",
					"value": {
						"value": "@{formatDateTime(pipeline().TriggerTime,'yyyy')}/@{formatDateTime(pipeline().TriggerTime,'MM')}/@{formatDateTime(pipeline().TriggerTime,'dd')}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable2",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "file",
					"value": {
						"value": "@{formatDateTime(pipeline().TriggerTime,'HH')}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Fail1",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Import API Data",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Import API Data').output.error.message",
						"type": "Expression"
					},
					"errorCode": {
						"value": "@activity('Import API Data').output.error.code",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Fail2",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Bronze to silver",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Bronze to silver').output.error.message",
						"type": "Expression"
					},
					"errorCode": {
						"value": "@activity('Bronze to silver').output.error.code",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Fail3",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "siver to gold",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('siver to gold').output.error.message",
						"type": "Expression"
					},
					"errorCode": {
						"value": "@activity('siver to gold').output.error.code",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"timestamp": {
				"type": "String"
			},
			"file": {
				"type": "String"
			}
		},
		"annotations": []
	}
}